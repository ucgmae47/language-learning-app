# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # Settings → API → service_role (keep secret — server only)

# Google AI Studio — https://aistudio.google.com/apikey
# The @ai-sdk/google provider reads GOOGLE_GENERATIVE_AI_API_KEY internally,
# but this project passes the key explicitly so GEMINI_API_KEY is used here.
GEMINI_API_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
WOTD_FROM_EMAIL=words@yourdomain.com   # must be a verified Resend sender domain

# Vercel Cron — https://vercel.com/docs/cron-jobs#securing-cron-jobs
CRON_SECRET=   # random string; Vercel injects this as the Authorization header

# GitHub Models API — https://github.com/settings/tokens
# Create a fine-grained token with no extra permissions; GitHub Models only needs the token itself
GITHUB_TOKEN=

# Groq — https://console.groq.com/keys  (free tier, no credit card required)
# Used for real-time grammar drill feedback (llama-3.1-8b-instant)
GROQ_API_KEY=

# NewsAPI — https://newsapi.org/register  (free dev tier: 100 req/day, localhost only)
# For production, upgrade to a paid plan or swap for The Guardian API (free, any env)
NEWS_API_KEY=

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Enable "YouTube Data API v3", create an API key, and restrict it to this API.
# Without this key the Music feature shows a "Watch on YouTube" link instead of embedding the video.
YOUTUBE_API_KEY=

# ElevenLabs TTS — https://elevenlabs.io  (free tier: 10 000 chars/month)
# The chatbot tutor uses this for human-sounding voice responses.
# Without this key the feature falls back to the browser's built-in speechSynthesis.
#
# IMPORTANT — free plan limitation:
# Library voices (e.g. Rachel) cannot be used via the API on the free plan.
# Either upgrade to Starter ($5/mo), OR create a voice in Voice Lab, copy its
# voice ID, and set it below. Library voice IDs will silently fall back to the
# robotic browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ES=   # Your Voice Lab voice ID for Spanish (required on free plan)
ELEVENLABS_VOICE_FR=   # Your Voice Lab voice ID for French (required on free plan)
# Set to "true" to hard-disable ElevenLabs TTS (recommended until Premium TTS is live)
DISABLE_TTS=true

# Personalized per-user AI story queue (Premium path). Default off = free library only.
ENABLE_PERSONAL_STORY_QUEUE=false

# Soft launch: only Stories unlocked on the wheel / direct URLs. Set "false" to open everything.
FREE_PREVIEW_STORIES_ONLY=true

# REST Countries v5 — https://restcountries.com  (optional; Explore uses static flags without it)
REST_COUNTRIES_API_KEY=

# verbecc conjugations — https://verbe.cc  (Dictionary feature)
# Override only if you self-host verbecc-svc; default public API works without a key.
VERBEC_BASE_URL=https://verbe.cc

# App URL (used in email confirmation links — must match Supabase redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
